  "repository": {
    "type": "git",
    "url": "https://github.com/ammein/custom-code-editor-a3"
  },
  "scripts": {
    "test": "mocha --reporter spec --inspect ./tests/**/*.js",
    "test-all": "npm run lint && npm run build-test && mocha --reporter spec --inspect ./tests/**/*.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=true npx eslint --config eslint.config.js '**/*.{js,jsx}' --quiet",
    "build-test": "node ./tests/build-test-package-json.js",
    "jsdoc": "jsdoc -c 'conf.json'",
    "deploy-page": "npm run jsdoc && gh-pages -d docs"
  },
